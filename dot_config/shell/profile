# Default programs
export EDITOR="nvim"
export BROWSER="firefox"

export LESS="-iR"

# Config files locations
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"
export XAUTHORITY="$XDG_RUNTIME_DIR"/Xauthority
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export GOPATH="$XDG_DATA_HOME/go"
export HISTFILE="$XDG_DATA_HOME/history"
export PYTHONSTARTUP="$XDG_CONFIG_HOME/python/pythonrc"

export PATH="$HOME/.config/shell/scripts:$PATH"

# Specific apps
export CUDA_CACHE_PATH="$XDG_CACHE_HOME"/nv

export PATH="/home/swordelf/.local/share/cargo/bin:$PATH"

# API keys
if [ -r "$HOME/.local/openrouter_key" ]; then
    export OPENROUTER_API_KEY="$(<"$HOME/.local/openrouter_key")"
fi
if [ -r "$HOME/.local/civitai_token" ]; then
    export CIVITAI_TOKEN="$(<"$HOME/.local/civitai_token")"
fi
if [ -r "$HOME/.local/hf_token" ]; then
    export HF_TOKEN="$(<"$HOME/.local/hf_token")"
fi

